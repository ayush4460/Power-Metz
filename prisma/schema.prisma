generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The core Post model optimized for fast reads on the public site
model Post {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique // Indexed automatically for fast lookups
  excerpt         String?
  content         String   // HTML string from TipTap
  coverImage      String?
  
  // Dedicated SEO Fields
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?

  published       Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?

  // Relations
  categories      Category[] // A post can have multiple categories

  @@index([published, publishedAt(sort: Desc)]) // Compound index for extremely fast sorting of published blogs
}

// Categories for Blog Posts
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  posts     Post[]
}

// The core News model optimized for fast reads on the public site
model News {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique // Indexed automatically for fast lookups
  excerpt         String?
  content         String   // HTML string from TipTap
  coverImage      String?
  
  // Dedicated SEO Fields
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?

  published       Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?

  // Relations
  categories      NewsCategory[] // A news item can have multiple categories

  @@index([published, publishedAt(sort: Desc)]) // Compound index for extremely fast sorting of published news
}

// Categories for News
model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  news      News[]
}

// Audit Log to track all Admin actions (Zero Downtime Tracking)
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // e.g., "CREATE_POST", "UPDATE_POST", "PUBLISH_POST", "CREATE_CATEGORY"
  entityId  String   // The ID of the post/category that was changed
  details   String?  // JSON string of changes (optional)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([entityId])
}

model JobDepartment {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs      JobOpening[]
}

model JobOpening {
  id           String   @id @default(cuid())
  title        String
  departmentId String?
  location     String
  type         String   // e.g., Full-time, Part-time
  description  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   JobDepartment?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  applications JobApplication[]

  @@index([departmentId])
}

enum Role {
  ADMIN
  VENDOR
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String?
  role               Role     @default(VENDOR)
  vendorSubmissionId String?  @unique
  setupToken         String?  @unique
  setupTokenExpiresAt DateTime?
  resetToken         String?  @unique
  resetTokenExpiresAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  submission         VendorSubmission? @relation(fields: [vendorSubmissionId], references: [id])
  warranties         Warranty[]
}

model VendorSubmission {
  id              String   @id @default(cuid())
  companyName     String
  contactPerson   String
  email           String
  phone           String
  productCategory String
  experience      String?
  message         String?
  status          String   @default("PENDING")
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User?
}

model CustomerSubmission {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  location        String
  productInterest String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model JobApplication {
  id          String   @id @default(cuid())
  jobId       String
  name        String
  email       String
  resumeUrl   String
  coverLetter String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  job         JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model ReachUsSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  purpose   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Warranty {
  id               String   @id @default(cuid())
  warrantyId       String   @unique // e.g., PM-2026-123456
  serialNumber     String
  
  productCategory  String   
  productModel     String   
  
  status           String   
  warrantyPlan     String   
  installDate      DateTime?
  expiryDate       DateTime?

  customerName     String
  customerPhone    String
  customerEmail    String?
  customerLocation String?
  installerName    String?
  
  extensionPending Boolean  @default(false)

  createdById      String?
  createdBy        User?    @relation(fields: [createdById], references: [id])
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
